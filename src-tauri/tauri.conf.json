{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calculatrice",
  "mainBinaryName": "calculatrice",
  "version": "0.1.0",
  "identifier": "fr.tonyboysuper.calculatrice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calculatrice",
        "width": 380,
        "height": 640,
        "minWidth": 320,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Calculatrice simple et scientifique",
    "longDescription": "Calculatrice en français inspirée de la calculatrice de Windows : modes standard et scientifique, historique et mémoire.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.svg"
    ]
  }
}
