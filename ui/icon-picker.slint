import { Palette } from "palette.slint";

export struct ThemeSwatch {
    background: color,
    border: color,
    accents: [color],
}

export struct PickerOption { name: string, icon: image, swatch: ThemeSwatch }

component OptionLabel inherits HorizontalLayout {
    in property <PickerOption> item;
    spacing: 8px;

    Rectangle {
        width: 20px;
        height: 15px;
        y: (parent.height - self.height) / 2;

        if root.item.icon.width > 0 : Image {
            width: parent.width;
            height: parent.height;
            source: root.item.icon;
            image-fit: contain;
            accessible-role: none;
        }

        if root.item.swatch.background != transparent : Rectangle {
            background: root.item.swatch.background;
            border-color: root.item.swatch.border;
            border-width: 1px;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 3px;
                padding-right: 3px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 1px;
                for accent in root.item.swatch.accents : Rectangle {
                    background: accent;
                    border-radius: 1px;
                }
            }
        }
    }
    Text {
        text: root.item.name;
        color: Palette.text;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
        accessible-role: none;
    }
}

export component IconPicker inherits Rectangle {
    in property <[PickerOption]> model;
    in property <string> label;
    in-out property <int> current-index;
    property <bool> popup-has-focus;
    callback selected();

    function select(index: int) {
        if index >= 0 && index < root.model.length && index != root.current-index {
            root.current-index = index;
            root.selected();
        }
    }

    function handle-arrows(event: KeyEvent) -> EventResult {
        if event.text == Key.UpArrow {
            root.select(root.current-index - 1);
            return accept;
        }
        if event.text == Key.DownArrow {
            root.select(root.current-index + 1);
            return accept;
        }
        return reject;
    }

    height: 32px;
    border-radius: 4px;
    background: trigger.has-hover ? Palette.hover : Palette.function;
    border-width: 1px;
    border-color: focus.has-focus || root.popup-has-focus ? Palette.accent : Palette.muted.with-alpha(0.24);
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.model[root.current-index].name;
    accessible-expandable: true;
    accessible-expanded: root.popup-has-focus;
    accessible-action-default => { popup.show(); }
    accessible-action-expand => { popup.show(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        OptionLabel { item: root.model[root.current-index]; }
        Image {
            source: @image-url("icons/chevron-down.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Palette.muted;
            accessible-role: none;
        }
    }

    focus := FocusScope {
        changed has-focus => {
            if self.has-focus {
                root.popup-has-focus = false;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                popup.show();
                return accept;
            }
            return root.handle-arrows(event);
        }
        trigger := TouchArea {
            clicked => { focus.focus(); popup.show(); }
            scroll-event(event) => {
                if focus.has-focus && abs(event.delta-y) > 2px {
                    root.select(root.current-index + (event.delta-y < 0px ? 1 : -1));
                    return accept;
                }
                return reject;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.model.length * 30px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: options-focus;

        options-focus := FocusScope {
            focus-changed-event => {
                root.popup-has-focus = self.has-focus;
            }
            key-pressed(event) => {
                if event.text == Key.Return || event.text == Key.Space || event.text == Key.Escape {
                    popup.close();
                    return accept;
                }
                return root.handle-arrows(event);
            }
            Rectangle {
                accessible-role: list;
                accessible-item-count: root.model.length;
                background: Palette.panel;
                border-width: 1px;
                border-color: Palette.hover;
                border-radius: 4px;
                VerticalLayout {
                    padding: 4px;
                    for item[index] in root.model: Rectangle {
                        height: 30px;
                        border-radius: 3px;
                        background: option.has-hover ? Palette.hover : index == root.current-index ? Palette.function : transparent;
                        accessible-role: list-item;
                        accessible-label: item.name;
                        accessible-item-selectable: true;
                        accessible-item-selected: index == root.current-index;
                        accessible-item-index: index;
                        accessible-action-default => { root.select(index); popup.close(); }
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            OptionLabel { item: item; }
                        }
                        option := TouchArea { clicked => { root.select(index); popup.close(); } }
                    }
                }
            }
        }
    }
}
